FROM node:22-alpine
WORKDIR /app
COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev
COPY server ./server
COPY web/dist ./web/dist
ENV NODE_ENV=production
ENV SERVICE=auth PORT=4001
EXPOSE 4001
# NOTE: Microservice split is roadmap. Currently boots monolith (same as Dockerfile).
# Future: replace CMD with dedicated authservice entrypoint when extracted.
CMD ["node","server/index.js"]
