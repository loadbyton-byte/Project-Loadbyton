# Loadbyton — Environment template
# Copy to .env and fill. See docs/DEVELOPER_GUIDE.md §7 and lib/config.js
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ADDITIONAL_ORIGINS=https://loadbyton.ae

# Required in production — generate once, never rotate without re-encrypting IBAN/TRN
# openssl rand -hex 32
ENCRYPTION_KEY=dev-key-not-for-prod-change-me

# Internal cron auth — POST /api/system/auto-release
INTERNAL_KEY=change-me-in-production

# Database — SQLite default (zero-config). For Postgres:
# USE_POSTGRES=true
# DATABASE_URL=postgres://loadbyton:loadbyton@localhost:5432/loadbyton
USE_POSTGRES=false
DATABASE_URL=
DB_POOL_MAX=20

# Redis — distributed rate limiting (optional in dev, recommended in prod)
REDIS_URL=redis://localhost:6379

# Payments — leave unset for internal ledger mode (no processor)
# PAYMENTS_PROVIDER=mock|telr|stripe|internal
PAYMENTS_PROVIDER=internal
PAYMENTS_WEBHOOK_SECRET=
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage — S3 for uploads, local disk fallback
S3_BUCKET=
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# SEO — build-time only, set these as Vercel *project* env vars (not here),
# since web/ is built separately by Vercel. Server-side rendering (this
# .env) never reads them. See web/index.html + web/scripts/vercel-static-seo.mjs.
# GA4 (VITE_GA_MEASUREMENT_ID) already defaults to the live property in
# web/index.html — only set this to override with a different property.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # Google Analytics 4 property (optional override)
# VITE_GSC_VERIFICATION=xxxxxxxxxxxxxxxx  # Search Console HTML-tag verification content
# SITE_ORIGIN=https://loadbyton.com     # overrides the canonical/sitemap origin if ever needed
