# Loadbyton — Environment template
# Copy to .env and fill. See docs/DEVELOPER_GUIDE.md §7 and lib/config.js
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ADDITIONAL_ORIGINS=https://loadbyton.ae

# Required in production — generate once, never rotate without re-encrypting IBAN/TRN
# openssl rand -hex 32
ENCRYPTION_KEY=dev-key-not-for-prod-change-me

# Internal cron auth — POST /api/system/auto-release, /api/system/detention-alarms
INTERNAL_KEY=change-me-in-production

# One-time bootstrap of the first admin account — POST /api/system/admin-setup.
# Required in production; there is no other way to create the first ADMIN.
ADMIN_SETUP_KEY=change-me-in-production

# Require TOTP MFA on admin login. Set to 0 only long enough to run
# POST /api/auth/mfa/setup for a fresh admin, then re-enable.
ADMIN_MFA_ENFORCE=1

# HSM stand-in for the escrow ledger's hash-chain signing keys (3 hex keys).
# openssl rand -hex 32 (x3, space-separated)
HSM_SECRET=

# Database — SQLite default (zero-config). Override the on-disk path if
# needed (defaults to server/data/loadbyton.db). For Postgres:
# USE_POSTGRES=true
# DATABASE_URL=postgres://loadbyton:loadbyton@localhost:5432/loadbyton
USE_POSTGRES=false
DATABASE_URL=
DB_POOL_MAX=20
DB_PATH=

# Redis — distributed rate limiting (optional in dev, recommended in prod)
REDIS_URL=redis://localhost:6379

# Payments — leave unset for internal ledger mode (no processor)
# PAYMENTS_PROVIDER=mock|telr|stripe|internal
PAYMENTS_PROVIDER=internal
PAYMENTS_WEBHOOK_SECRET=
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELR_WEBHOOK_SECRET=

# Customs — sovereign tax-clearing webhook fired on POST /api/jobs/:id/compliance
TAX_CLEARING_WEBHOOK=

# Storage — S3 for uploads, local disk fallback
S3_BUCKET=
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Set only for an S3-compatible provider other than AWS (e.g. Cloudflare R2,
# MinIO) — its presence is what selects that path over native AWS S3.
S3_ENDPOINT=

# Email — leave unset to stay in dev/no-op mode (logs instead of sending)
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp Business Cloud API — leave unset to stay dark (logs instead of sending)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telematics hardware webhook auth — POST /api/telematics/ingest
TELEMATICS_DEVICE_KEY=

# Observability
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# VAT invoice / legal-document letterhead — required for FTA-compliant invoices
PLATFORM_TRN=
PLATFORM_LEGAL_NAME=
PLATFORM_REGISTERED_ADDRESS=

# Demo/investor seed data (server/seed.js, index.js) — leave default in production
SEED_DEMO_ACCOUNTS=1
SEED_DEMO_ADMIN=0

# SEO — build-time only, set these as Vercel *project* env vars (not here),
# since web/ is built separately by Vercel. Server-side rendering (this
# .env) never reads them. See web/index.html + web/scripts/vercel-static-seo.mjs.
# GA4 (VITE_GA_MEASUREMENT_ID) already defaults to the live property in
# web/index.html — only set this to override with a different property.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # Google Analytics 4 property (optional override)
# VITE_GSC_VERIFICATION=xxxxxxxxxxxxxxxx  # Search Console HTML-tag verification content
# SITE_ORIGIN=https://loadbyton.com     # overrides the canonical/sitemap origin if ever needed
